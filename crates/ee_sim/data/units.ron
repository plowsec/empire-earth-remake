// Atomic Modern roster. Units: distances in centi-tiles, times in deciseconds,
// gather rates in centi-resource per second. Changing this file changes the data
// hash: multiplayer peers must run identical data.
(
    // percent multiplier: damage type -> [Infantry, Light, Heavy, Building, Air, Ship, Sub, None]
    damage_table: {
        Gun:       (100,  45,  10,   8,   0,  10,   0, 100),
        Cannon:    ( 60, 125, 150,  60,   0,  70,   0, 100),
        Explosive: (130, 100,  55, 150,   0,  80,   0, 100),
        Flak:      ( 25,  20,   5,   5, 150,   5,   0, 100),
        Flame:     (180,  60,  15,  50,   0,  10,   0, 100),
        Torpedo:   (  0,   0,   0,   0,   0, 200, 140, 100),
        NavalGun:  ( 80, 100, 100, 130,   0, 120,   0, 100),
        Bomb:      (100, 120, 110, 250,   0, 130,   0, 100),
        AirGun:    (100,  80,  25,  15, 120,  25,   0, 100),
        Missile:   ( 40, 110, 160,  70,  60, 110,   0, 100),
    },
    units: [
        // ---------------------------------------------------------------- citizens
        (key: "citizen", name: "Citizen", class: Citizen, armor_class: Infantry,
         hp: 75, speed: 150, radius: 20, sight: 600,
         cost: (food: 50), build_time: 120, pop: 1,
         weapons: [(dmg_type: Gun, damage: 4, range: 70, reload: 15)],
         gather: Some((food: 85, wood: 75, stone: 60, gold: 65, iron: 60)), carry: 10,
         builds: ["house", "settlement", "granary", "farm", "barracks", "tank_factory",
                  "airport", "naval_yard", "hospital", "guard_tower", "aa_site"],
         role: "Gathers resources, constructs and repairs buildings."),

        // ---------------------------------------------------------------- infantry
        (key: "rifleman", name: "Assault Rifleman", class: Infantry, armor_class: Infantry,
