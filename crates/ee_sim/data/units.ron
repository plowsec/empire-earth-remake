         cost: (food: 45, wood: 20), build_time: 100,
         weapons: [(dmg_type: Gun, damage: 14, range: 450, reload: 15)],
         role: "Versatile line infantry. Strong against infantry."),
        (key: "machine_gunner", name: "Machine Gunner", class: Infantry, armor_class: Infantry,
